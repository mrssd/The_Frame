# ─────────────────────────────────────────────────────────────
#  The Frame V2 — Environment Configuration Template
#  Copy to .env and adjust for your location and display.
# ─────────────────────────────────────────────────────────────

# ── Location & Weather (Open-Meteo, no API key required) ─────
LOCATION_NAME=Vancouver, BC
LATITUDE=49.260665
LONGITUDE=-123.213458
TIMEZONE=America/Vancouver
TEMP_UNIT=C

# ── Stage 1: Morning Weather Window (24-hour clock) ──────────
MORNING_START_HOUR=7
MORNING_END_HOUR=10
REFRESH_INTERVAL_MINUTES=30
CHECK_INTERVAL_SECONDS=60

# ── Display (Inky Impression 13.3" Spectra 6 — Portrait) ─────
DISPLAY_ORIENTATION=portrait
DISPLAY_ROTATION=90
DISPLAY_WIDTH=1200
DISPLAY_HEIGHT=1600
DISPLAY_SATURATION=0.5

# Watercolor sketch enhancement (for punchier E-Ink Spectra 6 rendering)
SKETCH_CONTRAST=1.40
SKETCH_COLOR_BOOST=1.85
SKETCH_SHARPNESS=1.30
SKETCH_GAMMA=2.20

MOCK_MODE=false
MOCK_OUTPUT_PATH=cache/preview.png

# ── Paths ────────────────────────────────────────────────────
CONDITIONS_DIR=conditions
PHOTOS_DIR=photos
CACHE_DIR=cache

# ── Stage 2: Dynamic Photo Frame & Web Portal ────────────────
PORTAL_ENABLED=true
PORTAL_HOST=0.0.0.0
PORTAL_PORT=8080
PORTAL_PASSCODE=1234

# Photo rendering:
#   "resize"  — resize full image directly to 1200x1600 (same as spectra6/image.py)
#   "cover"   — center-crop to fill 1200x1600
#   "contain" — fit full photo inside a white museum mat
PHOTO_FIT_MODE=resize
PHOTO_MAT_BORDER=0
PHOTO_CONTRAST=1.10
PHOTO_COLOR_BOOST=1.15
PHOTO_SHARPNESS=1.10

FONT_BOLD_PATH=
FONT_REGULAR_PATH=

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
